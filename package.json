{
	"name": "easy-sync",
	"version": "1.0.1-beta.3",
	"description": "Sync your Obsidian vault to AWS S3, Cloudflare R2, or any S3-compatible storage, with manual snapshot backups.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint .",
		"test": "tsx --test tests/*.test.ts",
		"prerelease": "node scripts/prerelease.mjs",
		"release:prerelease": "node scripts/prerelease.mjs --publish",
		"release:stable": "node scripts/release.mjs --publish",
		"changelog:release": "node scripts/generate-release-notes.mjs",
		"verify:release": "node scripts/verify-release.mjs",
		"prepublishOnly": "npm run build && npm test && npm run check-dist",
		"check-dist": "node scripts/check-dist.mjs"
	},
	"keywords": [
		"obsidian",
		"s3",
		"sync",
		"backup",
		"r2"
	],
	"license": "MIT",
	"devDependencies": {
		"@eslint/js": "^9.39.4",
		"@smithy/node-http-handler": "^4.5.3",
		"@types/node": "^22.15.17",
		"esbuild": "0.25.5",
		"eslint": "^9.39.4",
		"eslint-plugin-obsidianmd": "^0.4.0",
		"globals": "^17.6.0",
		"jiti": "^2.6.1",
		"obsidian": "latest",
		"tsx": "^4.23.15",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.59.1"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1026.0",
		"@smithy/protocol-http": "^5.3.7",
		"@smithy/types": "^4.11.0",
		"hash-wasm": "^4.11.0",
		"idb": "^8.0.1",
		"jszip": "^3.10.1"
	}
}
